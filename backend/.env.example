# ==========================================================
# AgriSabi v1.1 - Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# ==========================================================

# 1. Base API Settings
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 2. AWS Identity & Region
AWS_REGION=af-south-1
# AWS_ACCESS_KEY_ID=your_access_key      # Required if not running on EC2/ECS/Local Profile
# AWS_SECRET_ACCESS_KEY=your_secret_key  # Required if not running on EC2/ECS/Local Profile
AWS_ACCOUNT_ID=123456789012              # Your 12-digit AWS Account ID

# 3. AWS Bedrock Resources
BEDROCK_AGENT_ID=your_agent_id_here
BEDROCK_AGENT_ALIAS_ID=your_alias_id_here
BEDROCK_KB_ID=your_knowledge_base_id_here
BEDROCK_GUARDRAIL_ID=your_guardrail_id_here
NOVA_SONIC_MODEL_ID=amazon.nova-sonic-v1:0

# 4. Amazon Cognito (For Auth & Rate Limiting)
COGNITO_USER_POOL_ID=af-south-1_xxxxxxxxx
COGNITO_IDENTITY_POOL_ID=af-south-1:xxxxxx-xxxx-xxxx-xxxx-xxxxxx

# 5. DynamoDB & Storage Configuration
AWS_TABLE_PREFIX=dev_
AWS_BUCKET_PREFIX=agrisabi-dev-
# The config.py constructs standard names dynamically using the prefix, e.g.:
# DYNAMODB_SESSIONS_TABLE=${AWS_TABLE_PREFIX}agrisabi_sessions
# S3_DOCUMENTS_BUCKET=${AWS_BUCKET_PREFIX}documents

# 6. Third-Party Integrations
OPENWEATHERMAP_API_KEY=your_open_weather_api_key_here

# 7. Agent Tuning Thresholds (Optional Defaults)
DIAGNOSIS_CONFIDENCE_THRESHOLD=0.75
NOVA_SONIC_SESSION_TIMEOUT_SECONDS=300
RAG_TOP_K_DIAGNOSIS=5
RAG_TOP_K_ASSISTANT=10
